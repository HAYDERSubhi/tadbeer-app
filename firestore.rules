rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Personal user data ─────────────────────────────────────────────────
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Household / Family sharing ─────────────────────────────────────────
    match /households/{householdId} {

      function isMember() {
        return request.auth != null
          && request.auth.uid in resource.data.memberUids;
      }

      function isOwner() {
        return request.auth != null
          && resource.data.ownerId == request.auth.uid;
      }

      // ⛔ كان `allow create: if request.auth != null;` وحده — أي حساب يُنشئ
      //    عائلةً بمالك مزوَّر. الآن لا يُنشئ أحد عائلة إلا لنفسه، وهو ضمن أعضائها.
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;

      allow read:   if isMember();

      // ⛔ كان `allow update: if isMember();` وحده — يتحقّق ممّن يكتب ولا يتحقّق
      //    ممّا يكتبه. فكان أي عضو يجعل نفسه المالك بأمر واحد من متصفّحه ثم
      //    يُخرج المالك الحقيقي، أو يمسح memberUids فيصير سجلّ العائلة المالي
      //    كاملاً غير مقروء لأحد إلى الأبد (حذف المستند لا يحذف مجموعاته الفرعية).
      //    أُثبتت خمس هجمات على المحاكي قبل الإصلاح (2026-09-05).
      //
      //    الآن: لا يتغيّر إلا حقلا العضوية، ويبقى المالك عضواً دائماً.
      //    المسار السليم الوحيد من العميل هو مغادرة العضو
      //    (leaveHousehold ⇒ arrayRemove على members و memberUids) وهو يمرّ.
      //    الانضمام والإزالة يتمّان بصلاحيات الخادم فلا تحكمهما هذه القاعدة.
      allow update: if isMember()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['members', 'memberUids'])
        && resource.data.ownerId in request.resource.data.memberUids;

      allow delete: if isOwner();

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberUids;
      }

      match /{subcollection}/{docId}/{nested=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberUids;
      }
    }

    // ── Referrals (any auth user can create; referrer can read their own) ──
    // ⛔ كان الإنشاء `if request.auth != null` بلا أي قيد على المحتوى، وحارس
    //    «لا تُحِل نفسك» موجوداً في العميل وحده (recordReferral). فكان أي حساب
    //    يكتب إحالات باسم من يشاء ويضخّم عدّاده حتى ينال وسام «اجتماعي»،
    //    ويكتب مستندات بلا حدّ على حساب الفاتورة.
    //    الآن: تُسجَّل الإحالة فقط لمن أُحيل هو نفسه، ولا يُحيل أحد نفسه.
    match /referrals/{referralId} {
      allow create: if request.auth != null
        && request.resource.data.referredUid == request.auth.uid
        && request.resource.data.referrerUid is string
        && request.resource.data.referrerUid != request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['referrerUid', 'referredUid', 'createdAt']);
      allow read:   if request.auth != null
        && resource.data.referrerUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Feedback (write-only for authenticated users) ──────────────────────
    // ⚠️ كانت `if request.auth != null` وحدها (2026-09-05): أي حساب مسجَّل
    //    يستطيع نسبة ملاحظة إلى uid غيره — فيراسل صاحبُ التطبيق بريئاً ظنّاً
    //    أنه كتبها — أو كتابة آلاف المستندات بأي حجم على حساب الفاتورة.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['type', 'subject', 'details', 'uid', 'sentAt', 'createdAt'])
        && request.resource.data.details is string
        && request.resource.data.details.size() > 0
        && request.resource.data.details.size() <= 5000
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 200;
      allow read, update, delete: if false;
    }
  }
}
